# Copy to .env and adjust. Never commit .env.

# Protects the backend's demo endpoints (/api/stress, /api/crash)
API_KEY=change-me

# AWS credentials are read from ~/.aws (aws configure or aws login)
AWS_PROFILE=default
AWS_REGION=us-east-1

# Any Bedrock model you have access to, e.g. us.amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
